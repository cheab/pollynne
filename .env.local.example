# ⚠️ ARQUIVO DE CONFIGURAÇÃO LOCAL - NÃO COMMITAR!
# Este arquivo é apenas para desenvolvimento local
# Na Vercel, adicione as variáveis em Settings → Environment Variables

# Seu Access Token do Instagram (gerado em Facebook Developer)
# Vá para: developers.facebook.com → Seu App → Instagram Graph API
# Graph API Explorer: gere um token com permissão instagram_graph_user_media
NEXT_PUBLIC_INSTAGRAM_ACCESS_TOKEN=COLOQUE_SEU_TOKEN_AQUI

# Seu Instagram Business Account ID
# Obtenha em: Graph API Explorer → me?fields=id,username
# Será um número como: 17841408207834267
NEXT_PUBLIC_INSTAGRAM_BUSINESS_ACCOUNT_ID=COLOQUE_SEU_ACCOUNT_ID_AQUI

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=553195136154
